{
  "$schema": "teaching-blueprint/v1",
  "id": "blueprint-cs-networking-ch3",
  "title": "计算机网络 · 传输层协议",
  "subtitle": "端到端可靠数据传输与连接传输控制机制",
  "subject": "计算机网络",
  "theme": "dark",
  "targetAudience": {
    "level": "intermediate",
    "description": "计算机专业大二学生，已掌握网络层 IP 协议与 Socket 编程基础",
    "prerequisites": ["IP 基础报文结构", "应用层 HTTP 协议基本概念"]
  },
  "teachingPhilosophy": {
    "taxonomy": "bloom",
    "approach": "以问题为导向（PBL）+ 交互式时序动画演练"
  },
  "totalDuration": "90 分钟",
  "chapters": [
    {
      "id": "ch-03",
      "title": "第三章 传输层协议与连接管理",
      "order": 1,
      "duration": "90 分钟",
      "learningObjectives": [
        "掌握传输层为应用进程提供端到端通信的基本原理",
        "理解 TCP 三次握手与四次挥手的状态迁移过程",
        "掌握可靠传输机制（序号、确认应答、超时重传）"
      ],
      "knowledgePoints": [
        {
          "id": "kp-3-1",
          "title": "传输层服务与端口概念",
          "order": 1,
          "duration": "20 分钟",
          "cognitiveLevel": "understand",
          "teachingObjectives": ["复述 UDP 与 TCP 的服务差异", "理解端口号与复用分用的映射"],
          "keyPoints": ["端到端通信与点到点通信的区别", "常用标准端口号 (80, 443, 22)"],
          "difficultPoints": ["无连接 vs 面向连接在协议头部的体现"],
          "knowledgeType": "concept",
          "strategy": {
            "primaryForm": "comparison-table",
            "reasoning": "UDP 与 TCP 概念对比鲜明，适合采用对比卡片呈现",
            "alternativeForms": ["slide"]
          },
          "resources": [
            {
              "id": "res-3-1-ppt",
              "type": "ppt",
              "form": "slide",
              "title": "传输层概述 PPT",
              "description": "讲解 UDP/TCP 的异同与端口号映射",
              "priority": "required",
              "spec": {
                "interactionType": null,
                "visualElements": ["对比表格", "端口分布图"],
                "dataRequirements": ["UDP/TCP 协议头部对照表"],
                "estimatedComplexity": "low"
              }
            }
          ],
          "dependencies": [],
          "tags": ["传输层", "端口", "UDP", "TCP"]
        },
        {
          "id": "kp-3-2",
          "title": "TCP 三次握手与连接建立",
          "order": 2,
          "duration": "40 分钟",
          "cognitiveLevel": "apply",
          "teachingObjectives": ["能画出三次握手报文交互图", "能分析为什么必须是三次握手而非两次"],
          "keyPoints": ["SYN / SYN+ACK / ACK 报文标志位与序号初始同步", "异常失效连接请求处理"],
          "difficultPoints": ["网络延迟导致的历史旧连接请求对服务端的干扰"],
          "knowledgeType": "process",
          "strategy": {
            "primaryForm": "animation",
            "reasoning": "报文在客户端与服务端之间的时序传递带有强状态迁移属性，必须通过分步互动动画展现",
            "alternativeForms": ["flowchart", "slide"]
          },
          "resources": [
            {
              "id": "res-3-2-ppt",
              "type": "ppt",
              "form": "slide",
              "title": "TCP 三次握手讲解 PPT",
              "description": "讲解三次握手流程与 SYN 洪泛攻击防护",
              "priority": "required",
              "spec": {
                "interactionType": null,
                "visualElements": ["时序图", "要点列表"],
                "dataRequirements": ["SYN/ACK/seq/ack 字段定义"],
                "estimatedComplexity": "low"
              }
            },
            {
              "id": "res-3-2-interactive",
              "type": "interactive",
              "form": "animation",
              "title": "TCP 三次握手互动演练",
              "description": "学生可通过单步点击演练报文发送、观察 SEQ/ACK 变化与状态迁移",
              "priority": "required",
              "spec": {
                "interactionType": "step-through",
                "visualElements": ["Client 节点", "Server 节点", "动态报文包", "状态机看板"],
                "dataRequirements": ["报文序列数据", "状态转变规则表"],
                "estimatedComplexity": "medium"
              }
            }
          ],
          "dependencies": ["kp-3-1"],
          "tags": ["TCP", "三次握手", "连接建立", "状态机"]
        }
      ]
    }
  ]
}
