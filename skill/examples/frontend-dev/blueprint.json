{
  "$schema": "teaching-blueprint/v1",
  "id": "fe-react-301",
  "title": "React 深入原理",
  "subtitle": "从虚拟 DOM 到 Fiber 架构",
  "subject": "Frontend Development / React",
  "targetAudience": {
    "level": "advanced",
    "description": "有 1-2 年 React 开发经验的前端工程师",
    "prerequisites": ["React 基础使用", "JavaScript 进阶", "数据结构基础"]
  },
  "teachingPhilosophy": {
    "taxonomy": "bloom",
    "approach": "从问题出发，先理解为什么需要 Fiber，再理解如何实现"
  },
  "totalDuration": "60min",
  "chapters": [
    {
      "id": "ch-01",
      "title": "Fiber 架构",
      "order": 1,
      "duration": "30min",
      "learningObjectives": [
        "理解 Fiber 架构解决的核心问题",
        "掌握 Fiber 节点的数据结构与遍历方式"
      ],
      "knowledgePoints": [
        {
          "id": "kp-fiber-structure",
          "title": "Fiber 节点结构",
          "order": 1,
          "duration": "15min",
          "cognitiveLevel": "understand",
          "knowledgeType": "concept",
          "teachingObjectives": [
            "能描述 Fiber 节点的核心字段",
            "能解释 child/sibling/return 指针的含义",
            "能理解为什么用链表替代递归"
          ],
          "keyPoints": [
            "Fiber 节点的 child/sibling/return 三指针",
            "effectTag 与状态更新",
            "双缓冲树结构"
          ],
          "difficultPoints": [
            "为什么用链表替代递归（可中断性）",
            "双缓冲树的 current/workInProgress 切换"
          ],
          "strategy": {
            "primaryForm": "svg-visualization",
            "reasoning": "Fiber 节点结构是一个带有三指针的树形数据结构，学生需要交互式地探索节点之间的 child/sibling/return 关系，SVG 可视化支持自由探索、缩放和点击查看详情，比静态图更适合理解复杂的指针拓扑",
            "alternativeForms": ["animation", "diagram"]
          },
          "resources": [
            {
              "id": "res-fiber-structure-svg",
              "type": "interactive",
              "form": "svg-visualization",
              "title": "Fiber 节点结构交互探索",
              "description": "可交互的 Fiber 树可视化，支持点击节点查看字段详情、高亮 child/sibling/return 指针路径、切换 current/workInProgress 双缓冲视图",
              "priority": "required",
              "spec": {
                "interactionType": "free-explore",
                "visualElements": ["Fiber 树节点图", "三指针连线", "节点详情面板", "双缓冲切换按钮", "effectTag 标注"],
                "dataRequirements": ["Fiber 节点字段定义", "示例组件树对应的 Fiber 树结构", "current/workInProgress 双缓冲数据"],
                "estimatedComplexity": "high"
              }
            },
            {
              "id": "res-fiber-structure-ppt",
              "type": "ppt",
              "form": "slide",
              "title": "Fiber 节点结构讲解课件",
              "description": "配合交互探索使用的讲解幻灯片，包含 Fiber 设计动机、核心字段说明和与递归调用的对比",
              "priority": "required",
              "spec": {
                "interactionType": null,
                "visualElements": ["节点结构图", "字段说明表", "递归 vs 链表对比图"],
                "dataRequirements": ["Fiber 节点核心字段列表", "设计动机说明", "链表遍历优势分析"],
                "estimatedComplexity": "low"
              }
            }
          ],
          "dependencies": [],
          "tags": ["react", "fiber", "data-structure"]
        },
        {
          "id": "kp-fiber-reconciliation",
          "title": "Fiber 协调过程",
          "order": 2,
          "duration": "12min",
          "cognitiveLevel": "analyze",
          "knowledgeType": "process",
          "teachingObjectives": [
            "能描述 reconcile 的完整流程",
            "能理解时间切片如何实现可中断渲染"
          ],
          "keyPoints": [
            "深度优先遍历顺序",
            "时间切片与 requestIdleCallback",
            "commit 阶段的不可中断性"
          ],
          "difficultPoints": [
            "可中断渲染的实现原理",
            "为什么 commit 阶段不能中断"
          ],
          "strategy": {
            "primaryForm": "animation",
            "reasoning": "协调过程是一个按深度优先顺序逐步遍历 Fiber 树的过程，涉及 beginWork/completeWork 的交替执行和时间切片的暂停恢复，动画形式能让学生清晰看到遍历顺序、中断点和恢复机制",
            "alternativeForms": ["flowchart", "simulator"]
          },
          "resources": [
            {
              "id": "res-fiber-reconcile-anim",
              "type": "interactive",
              "form": "animation",
              "title": "Fiber 协调过程动画演示",
              "description": "逐步展示 reconcile 阶段的深度优先遍历过程，包含时间切片中断/恢复、beginWork/completeWork 交替和 commit 阶段执行",
              "priority": "required",
              "spec": {
                "interactionType": "step-through",
                "visualElements": ["Fiber 树高亮遍历", "时间轴面板", "中断/恢复标记", "阶段标签", "调用栈可视化"],
                "dataRequirements": ["reconcile 遍历步骤序列", "时间切片中断点", "beginWork/completeWork 执行记录", "commit 阶段操作列表"],
                "estimatedComplexity": "high"
              }
            },
            {
              "id": "res-fiber-reconcile-ppt",
              "type": "ppt",
              "form": "slide",
              "title": "Fiber 协调过程讲解课件",
              "description": "配合动画使用的讲解幻灯片，包含协调流程图、时间切片原理和 render/commit 两阶段对比",
              "priority": "required",
              "spec": {
                "interactionType": null,
                "visualElements": ["流程图", "时间切片示意图", "两阶段对比表"],
                "dataRequirements": ["reconcile 流程描述", "requestIdleCallback 原理", "render 与 commit 阶段区别"],
                "estimatedComplexity": "low"
              }
            }
          ],
          "dependencies": ["kp-fiber-structure"],
          "tags": ["react", "fiber", "reconciliation", "scheduling"]
        }
      ]
    }
  ]
}
